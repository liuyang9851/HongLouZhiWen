# =============================================================
# 红楼智问 · 后端环境变量模板
# =============================================================
# 用法：
#   1. cp .env.example .env
#   2. 填入你自己的 API Key
#
# ⚠️ .env 含密钥，不要提交到 git
# =============================================================

# ---------- 必填：LLM API Key ----------
# DeepSeek 官方（默认模型）
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 智谱 GLM（可选，用于多模型切换/对比）
# 申请地址：https://open.bigmodel.cn/usercenter/apikeys
# ZHIPU_API_KEY=your_zhipu_api_key_here

# ---------- 存储模式（关键配置）----------
# local  = 用文件数据源（HDFS 或 本地文件）—— 推荐
# hbase  = 用 HBase 表（仅 HBase 1.x/2.x 可用；3.x 已移除 Thrift1）
# auto   = 优先文件数据源，都不行才试 HBase
HLM_STORAGE=local

# ---------- 数据源（S39 新增，自动探测）----------
# hdfs   = 从 HDFS 读（WebHDFS，版本无关，推荐）
# local  = 从本地 JSONL 读
# hbase  = 从 HBase 读
# auto   = 依次探测 hdfs → local → hbase（默认）
# HLM_DATA_SOURCE=auto

# 本地 JSONL 目录（local 数据源用）
HLM_DATA_DIR=/app/data

# WebHDFS 地址（hdfs 数据源用）
#   Hadoop 3.x 端口 9870；Hadoop 2.x 端口 50070
#   若应用容器和 Hadoop 在同一 Docker 网络，写容器名即可
# HLM_WEBHDFS_URL=http://master:9870/webhdfs/v1
HLM_HDFS_BASE=/hlm

# ---------- 仅 HBase 模式需要 ----------
# HLM_HBASE_HOST=master
# HLM_HBASE_PORT=9090

# ---------- 模型默认值 ----------
HLM_DEFAULT_MODEL=deepseek-flash

# ---------- 检索参数（一般不用改）----------
HLM_EMB_DIM=512
HLM_RRF_K=60
HLM_TOPK_RECALL=30
HLM_TOPK_CONTEXT=5

# ---------- 关键词缓存 ----------
HLM_KW_CACHE_MAX=500
HLM_KW_CACHE_TTL=604800
HLM_KW_CACHE_PATH=/app/qa_logs/keyword_cache.json

# ---------- 启动预热 ----------
# 设为 1 跳过预热（开发调试用，省 token）
HLM_SKIP_WARMUP=0
# 只预热前 N 个问题（0 = 全部 15 个）
HLM_WARMUP_N=0

# ---------- 问答日志目录 ----------
HLM_QA_LOG=/app/qa_logs
