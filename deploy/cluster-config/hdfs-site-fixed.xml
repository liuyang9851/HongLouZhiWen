<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  集群 HDFS 配置（S40 修复版）

  与原版的唯一差异：
    dfs.replication: 2 → 1

  为什么改：
    单机 Docker 环境下，slave 容器存活不稳定（ZK 会话反复过期导致退出）。
    HBase 要求 2 副本写入，一旦只剩 1 个 DataNode 在线就报
    "NoRouteToHostException: No route to host" → HMaster 崩溃
    → master 容器退出 → slave 失去 ZK → 全部退出 → 死循环。

    改成 1 副本后，只要有 1 个 DataNode 在线，HBase 就能正常写入。
    代价：没有冗余，DataNode 挂掉会丢数据。
    在单机演示环境可接受（数据在 deploy/data 和单节点 hlm-hdfs 都有备份）。

  其余配置保持原样，避免引入新的不确定性。
-->
<configuration>
  <!-- S40 关键改动：副本数 2 → 1 -->
  <property><name>dfs.replication</name><value>1</value></property>

  <property><name>dfs.namenode.name.dir</name><value>file:///data/namenode</value></property>
  <property><name>dfs.datanode.data.dir</name><value>file:///data/datanode</value></property>
  <property><name>dfs.permissions.enabled</name><value>false</value></property>
  <property><name>dfs.namenode.datanode.registration.ip-hostname-check</name><value>false</value></property>
  <property><name>dfs.datanode.max.transfer.threads</name><value>4096</value></property>

  <!-- S40 新增：放宽 DataNode 失联判定，减少误判 -->
  <!-- 默认 10.5 分钟太短，容器重启期间容易被标记为 dead -->
  <property><name>dfs.namenode.heartbeat.recheck-interval</name><value>600000</value></property>
  <property><name>dfs.heartbeat.interval</name><value>10</value></property>

  <!-- S40 新增：缩短 safe mode 等待，避免长时间卡住 -->
  <property><name>dfs.namenode.safemode.threshold-pct</name><value>0.999</value></property>
  <property><name>dfs.namenode.safemode.min.datanodes</name><value>1</value></property>
  <property><name>dfs.namenode.safemode.extension</name><value>10000</value></property>
</configuration>
