<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  HDFS 站点配置 —— 单节点伪分布式

  关键取舍：
    · replication=1
        单节点没有第二台机器做副本，设 1 避免 "under-replicated blocks" 警告。
        （原集群是 3 节点所以设 2）
    · dfs.namenode.http-address 必须绑 0.0.0.0
        否则容器外访问不到 WebHDFS（默认绑 localhost 就只能在容器内用）
    · 关闭权限检查
        单机环境没配 Kerberos，开着会因 UID 不匹配拒绝写入
-->
<configuration>
    <!-- ========== NameNode ========== -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///data/namenode</value>
    </property>

    <!-- WebHDFS / UI，必须 0.0.0.0 才能从容器外访问 -->
    <property>
        <name>dfs.namenode.http-address</name>
        <value>0.0.0.0:9870</value>
    </property>

    <property>
        <name>dfs.namenode.rpc-address</name>
        <value>0.0.0.0:9000</value>
    </property>

    <!-- 单节点：不需要 SecondaryNameNode -->
    <property>
        <name>dfs.namenode.secondary.http-address</name>
        <value>0.0.0.0:9868</value>
    </property>

    <!-- ========== DataNode ========== -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file:///data/datanode</value>
    </property>

    <property>
        <name>dfs.datanode.http.address</name>
        <value>0.0.0.0:9864</value>
    </property>

    <!-- ========== 副本与块 ========== -->
    <!-- 单节点只能存 1 份，设 2 会一直报 under-replicated -->
    <property>
        <name>dfs.replication</name>
        <value>1</value>
    </property>

    <property>
        <name>dfs.blocksize</name>
        <value>134217728</value>
    </property>

    <!-- ========== 权限 ========== -->
    <!-- 单机开发环境关闭，否则容器内 UID 与 HDFS 记录不一致会 Permission denied -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
    </property>

    <!-- ========== 稳定性调优（小内存环境）========== -->
    <property>
        <name>dfs.namenode.handler.count</name>
        <value>10</value>
    </property>

    <property>
        <name>dfs.datanode.handler.count</name>
        <value>5</value>
    </property>

    <!-- 关闭短路读（容器内没配 libhadoop native，开了反而报错） -->
    <property>
        <name>dfs.client.read.shortcircuit</name>
        <value>false</value>
    </property>
</configuration>
